# ============================================================
# Sistema de Nómina · Alcaldía Bolivariana del Municipio Guásimos
# Variables de entorno del backend
# ============================================================

NODE_ENV=development
PORT=4000

# ------------------------------------------------------------
# Base de datos PostgreSQL
# Si DATABASE_URL está definida, tiene prioridad sobre las
# variables DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME.
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nomina_guasimos

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nomina_guasimos

# true cuando el proveedor de PostgreSQL exige SSL
DB_SSL=false
DB_POOL_MAX=10

# Origen permitido para el frontend (Next.js)
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------
# Autenticación JWT
# Reemplace el secreto por una cadena larga y aleatoria (mínimo
# 32 caracteres). Puede generarlo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_EXPIRES_IN acepta valores de jsonwebtoken como 8h, 1d o 30m.
# ------------------------------------------------------------
JWT_SECRET=cambie-este-secreto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h
